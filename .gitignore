# 忽略规则，随技术栈确定后补充

# 依赖
node_modules/
.venv/
venv/

# 构建产物
dist/
build/
out/
release/
*.tsbuildinfo

# 原生构建
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.sys
x64/
Debug/
Release/
# ↑ 这两条是原生（VS）构建产物；Windows 文件系统大小写不敏感，
#   Debug/ 会误伤 Android 的 src/debug/ 源集（仅 debug 构建的走查
#   驱动器住在那里），显式反排除
!apps/android/app/src/debug/
!apps/android/app/src/debug/**

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志与本地数据
*.log
logs/

# 本地记忆与工作区数据，不进版本库
.workbuddy/

# 构建输出
apps/desktop/out/
apps/desktop/node_modules/
# scrcpy 二进制暂存（由 scripts/stage-scrcpy.mjs 从本机发行包复制，不进版本库）
apps/desktop/vendor/

# ---------- Android ----------
# 本机无 Android Studio，工具链装在 .toolchain/，体积数 GB，不进版本库
.toolchain/
apps/android/app/build/
apps/android/build/
apps/android/.gradle/
apps/android/local.properties
*.apk
*.aab
