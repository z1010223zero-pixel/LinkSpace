{"constraints":{"chunkSizeBytes":4194304,"chunkSizeHuman":"4MiB","clipboardMaxBytes":524288,"clipboardMaxHuman":"512KiB","clipboardSuppressMs":500,"controlMaxPayloadBytes":1048576,"controlMaxPayloadHuman":"1MiB","defaultGrantScope":["file","clipboard"],"deletedMessageTypes":["transfer.progress"],"heartbeat":{"intervalHuman":"5s","intervalMs":5000,"missedBeforeOffline":3,"timeoutHuman":"15s","timeoutMs":15000},"inputEvent":{"mouseButtons":["left","right","middle"],"vkMax":255,"vkMin":0,"wheelClamp":1000},"maxChunkBodyBytes":33554432,"maxChunkBodyHuman":"32MiB","maxClockSkewHuman":"±60s","maxClockSkewMs":60000,"maxCoord":32768,"maxEventsPerMessage":64,"pairingCode":{"digits":6,"maxAttempts":5,"maxPending":8,"ttlHuman":"60s","ttlMs":60000},"protocolVersion":1,"rateLimitsPerSecond":{"clipboard.share":5,"input.event":200},"sessionIdPattern":"[A-Za-z0-9_-]{1,64}","streamDirections":["forward","reverse"],"streamQualityPresets":[{"bps":4000000,"fps":30,"label":"720p","width":1280},{"bps":8000000,"fps":30,"label":"1080p","width":1920},{"bps":14000000,"fps":30,"label":"1440p","width":2560},{"bps":24000000,"fps":30,"label":"2160p","width":3840}],"streamTiers":[{"bps":null,"label":"t0-uncapped"},{"bps":6000000,"label":"t1-6M"},{"bps":3000000,"label":"t2-3M"},{"bps":1500000,"label":"t3-1.5M"}],"transferIdPattern":"[A-Za-z0-9_-]{1,64}"},"envelope":{"description":"所有控制消息统一封装（protocol.md §3）。payload 为对象时必填校验见 isEnvelope；payload 本身在信封表里标为可选，但各消息定义要求其为对象。","fields":[{"description":"协议版本","name":"v","required":true,"type":"number"},{"description":"消息类型，见 messageTypes","name":"type","required":true,"type":"string"},{"description":"消息唯一 ID，用于请求-响应关联与去重","format":"uuid","name":"id","required":true,"type":"string"},{"description":"发送方设备 ID","name":"from","required":true,"type":"string"},{"description":"接收方设备 ID","name":"to","required":true,"type":"string"},{"description":"毫秒时间戳，用于重放窗口判断","name":"ts","required":true,"type":"number"},{"description":"各消息自定义载荷","name":"payload","required":false,"type":"object"}]},"errorCodes":[{"code":"AUTH_REQUIRED","meaning":"未配对或授权不足","note":"需用户操作","retryable":false},{"code":"NOT_TRUSTED","meaning":"信任已撤销","retryable":false},{"code":"SCOPE_DENIED","meaning":"能力不在授权范围内","note":"需重新授权","retryable":false},{"code":"VERSION_MISMATCH","meaning":"协议版本不兼容","retryable":false},{"code":"RESOURCE_BUSY","meaning":"已有同名会话在跑","retryable":true},{"code":"TRANSFER_IO","meaning":"读写失败","retryable":true},{"code":"TRANSFER_DIGEST","meaning":"校验失败","note":"重传该块","retryable":true},{"code":"DEVICE_OFFLINE","meaning":"目标不可达","retryable":true},{"code":"INTERNAL","meaning":"未分类","retryable":false}],"messageTypes":[{"description":"建立连接后首次发送，声明身份与能力","direction":"bidirectional","payload":["displayName","deviceType","caps","pubkeyFingerprint"],"section":"4.1","type":"device.announce"},{"description":"发起配对；配对码由接收方生成并展示","direction":"initiator-to-receiver","payload":["displayName","deviceType","pubkeyFingerprint","pairingCode?"],"section":"4.1","type":"pair.request"},{"description":"提示发起方去要配对码；不携带配对码本身","direction":"receiver-to-initiator","payload":["expiresAt"],"section":"4.1","type":"pair.challenge"},{"description":"用户确认后发送；deviceId 是发送方自己的 id","direction":"receiver-to-initiator","payload":["deviceId","trustScope"],"section":"4.1","type":"pair.approve"},{"description":"发起方提交人工抄录的配对码","direction":"initiator-to-receiver","payload":["code"],"section":"4.1","type":"pair.submit"},{"description":"用户拒绝或超时","direction":"receiver-to-initiator","payload":["reason"],"section":"4.1","type":"pair.reject"},{"description":"撤销信任，立即生效；deviceId 是撤销方自己的 id；接收方必须核对 deviceId == from == conn.peerId","direction":"bidirectional","payload":["deviceId"],"section":"4.1","type":"pair.revoke"},{"description":"配对失败，code 见 errorCodes","direction":"bidirectional","payload":["code","message"],"section":"4.1","type":"pair.error"},{"description":"本机改名后广播给已连接对端；仅当 from 在信任清单内才更新","direction":"bidirectional","payload":["displayName"],"section":"4.1","type":"device.rename"},{"description":"心跳保活；payload 当前为空对象","direction":"bidirectional","payload":[],"section":"4.2","type":"device.heartbeat"},{"description":"能力变更时推送","direction":"bidirectional","payload":["caps"],"section":"4.2","type":"device.capabilities"},{"description":"优雅断连，避免等待心跳超时","direction":"bidirectional","payload":["reason"],"section":"4.2","type":"device.disconnect"},{"description":"sessionType: scrcpy / input / display-extend","direction":"controller-to-controlled","payload":["sessionType","params"],"section":"4.3","type":"session.start"},{"description":"用户确认后才发送","direction":"controlled-to-controller","payload":["sessionId"],"section":"4.3","type":"session.accept"},{"description":"拒绝，含未授权原因","direction":"controlled-to-controller","payload":["reason"],"section":"4.3","type":"session.reject"},{"description":"任一方均可终止","direction":"bidirectional","payload":["sessionId","reason"],"section":"4.3","type":"session.stop"},{"description":"状态同步","direction":"controlled-to-controller","payload":["sessionId","state"],"section":"4.3","type":"session.state"},{"description":"kind 目前只有 text；图片与文件走传输通道","direction":"bidirectional","payload":["kind","text"],"section":"4.4","type":"clipboard.share"},{"description":"请求传输；files: [{name, size, mime}]","direction":"sender-to-receiver","payload":["transferId","files","totalSize"],"section":"4.5","type":"transfer.offer"},{"description":"用户确认保存路径后发送；token 是数据面唯一凭证","direction":"receiver-to-sender","payload":["transferId","token"],"section":"4.5","type":"transfer.accept"},{"description":"拒绝或路径不可写","direction":"receiver-to-sender","payload":["transferId","reason"],"section":"4.5","type":"transfer.reject"},{"description":"HTTP 分块体，非 WS 消息；见 protocol.md §5","direction":"bidirectional","payload":[],"section":"4.5","transport":"https-data-plane","type":"transfer.chunk"},{"description":"校验通过后发送；digests 是文件名 → 整体 SHA-256 的映射","direction":"receiver-to-sender","payload":["transferId","digests"],"section":"4.5","type":"transfer.complete"},{"description":"取消，已写入部分按策略处理","direction":"bidirectional","payload":["transferId","reason"],"section":"4.5","type":"transfer.cancel"},{"description":"失败，可重试的错误在 code 中标识","direction":"bidirectional","payload":["transferId","code","message"],"section":"4.5","type":"transfer.error"},{"description":"输入事件流；sessionId 必须匹配活动会话，批量单条消息上限见 constraints.maxEventsPerMessage","direction":"controller-to-controlled","payload":["sessionId","events"],"section":"4.6","type":"input.event"},{"description":"请求开始投屏；寄生在键鼠会话内；scaleWidth 档位见 constraints.streamQualityPresets。反向（桌面看平板）时角色互换、不要求活动 input 会话，见 protocol.md §4.7 [PROTOCOL] 2026-11-02 登记","direction":"controller-to-controlled","payload":["display?","scaleWidth?"],"section":"4.7","type":"screen.stream.request"},{"description":"多显示器清单；displays: [{x, y, w, h}]","direction":"controlled-to-controller","payload":["displays"],"section":"4.7","type":"screen.stream.displays"},{"description":"物理光标坐标广播（region-local 像素 + 区域尺寸，33ms 限流）","direction":"controlled-to-controller","payload":["x","y","w","h"],"section":"4.7","type":"screen.cursor"},{"description":"推流开始。反向时 w/h 为平板编码后的实际流尺寸，见 protocol.md §4.7 [PROTOCOL] 2026-11-02 登记","direction":"controlled-to-controller","payload":["w","h","scaleWidth"],"section":"4.7","type":"screen.stream.start"},{"description":"停止投屏：direction 标识停哪一路流（forward = 线 1 桌面→平板，reverse = 反向平板→桌面）；direction 缺失时按单路在跑/双向在跑规则解析（见 protocol.md §4.7），非法值忽略","direction":"bidirectional","payload":["direction?"],"section":"4.7","type":"screen.stream.stop"},{"description":"投屏失败回告","direction":"controlled-to-controller","payload":["message"],"section":"4.7","type":"screen.stream.error"},{"description":"将文本写入被控端剪贴板并向前台注入 Ctrl+V；寄生 input 会话授权","direction":"controller-to-controlled","payload":["text"],"section":"4.8","type":"screen.paste"}],"name":"linkspace-protocol","note":"本文件是 docs/protocol.md 的机器可读版，不是第二份规范。两者冲突时以 protocol.md 为准。transfer.progress 已按 docs/line2-line3-direction.md §5 的决定删除，不出现在此文件中。数值单位除特别注明外均为字节或毫秒。","source":"docs/protocol.md","version":1}