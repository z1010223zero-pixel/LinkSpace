{
  "name": "linkspace-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LinkSpace 桌面端 —— 局域网多设备协作工作空间",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "clean": "node -e \"fs.rmSync('out',{recursive:true,force:true})\"",
    "verify": "node scripts/build-verify.mjs && node out/verify/verify.js",
    "verify:transfer": "node scripts/build-verify-transfer.mjs && node out/verify/verify-transfer.js",
    "verify:pairing": "node scripts/build-verify-pairing.mjs",
    "verify:e2e": "node scripts/build-verify-e2e.mjs",
    "verify:layout": "node scripts/build-verify-layout.mjs",
    "verify:net": "node scripts/build-verify-net.mjs",
    "probe:xplat": "esbuild scripts/xplat-probe.ts --bundle --platform=node --format=cjs --outfile=out/verify/xprobe.js --external:electron --external:ws --external:bonjour-service --external:selfsigned"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "selfsigned": "^5.5.0",
    "vue": "^3.5.44",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "37.10.3",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
