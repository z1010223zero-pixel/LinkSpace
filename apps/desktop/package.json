{
  "name": "linkspace-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LinkSpace 桌面端 —— 局域网多设备协作工作空间",
  "author": "LinkSpace",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit",
    "clean": "node -e \"fs.rmSync('out',{recursive:true,force:true})\"",
    "stage:scrcpy": "node scripts/stage-scrcpy.mjs",
    "dist": "electron-vite build && node scripts/stage-scrcpy.mjs && electron-builder --win --publish never",
    "sbom": "node scripts/generate-sbom.mjs",
    "verify": "node scripts/build-verify.mjs && node out/verify/verify.js",
    "verify:transfer": "node scripts/build-verify-transfer.mjs && node out/verify/verify-transfer.js",
    "verify:pairing": "node scripts/build-verify-pairing.mjs",
    "verify:e2e": "node scripts/build-verify-e2e.mjs",
    "verify:layout": "node scripts/build-verify-layout.mjs",
    "verify:net": "node scripts/build-verify-net.mjs",
    "verify:heartbeat": "node scripts/build-verify-heartbeat.mjs",
    "verify:clipboard": "node scripts/build-verify-clipboard.mjs",
    "verify:input": "node scripts/build-verify-input.mjs",
    "verify:extend": "node scripts/build-verify-extend.mjs",
    "verify:vdd-driver": "node scripts/build-verify-vdd-driver.mjs",
    "verify:binding": "node scripts/build-verify-binding.mjs",
    "verify:mdns": "node scripts/build-mdns-test.mjs",
    "probe:xplat": "esbuild scripts/xplat-probe.ts --bundle --platform=node --format=cjs --outfile=out/verify/xprobe.js --external:electron --external:ws --external:bonjour-service --external:selfsigned",
    "verify:protocol": "node scripts/check-protocol.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "koffi": "^3.3.5",
    "selfsigned": "^5.5.0",
    "vue": "^3.5.44",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "37.10.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "license-checker": "^25.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "build": {
    "appId": "cn.linkspace.desktop",
    "productName": "LinkSpace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/scrcpy",
        "to": "scrcpy"
      },
      {
        "from": "resources/vdd",
        "to": "vdd"
      },
      {
        "from": "resources/winhelper",
        "to": "winhelper"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  }
}
